# Mesmo banco que o bot usa. Inclua o nome do banco no caminho!
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/AnimeFightDB?appName=AnimeFightSite

# Link de convite do bot (botão principal do site)
NEXT_PUBLIC_INVITE_URL=https://discord.com/oauth2/authorize?client_id=SEU_CLIENT_ID&scope=bot+applications.commands&permissions=274877959168

# Link do servidor de suporte
NEXT_PUBLIC_SUPPORT_URL=https://discord.gg/SEU_CONVITE

# URL pública do site (usada nas meta tags de compartilhamento)
NEXT_PUBLIC_SITE_URL=https://anibattle.com.br
