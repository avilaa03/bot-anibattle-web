# ---------- Banco ----------
# Mesmo banco que o bot usa. Inclua o nome do banco no caminho!
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/AnimeFightDB?appName=AnimeFightSite

# ---------- URL do site ----------
# Em desenvolvimento use http://localhost:3000.
# ATENÇÃO: precisa bater exatamente com o Redirect URI cadastrado no
# Discord Developer Portal, senão o login falha.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Login com Discord ----------
# Discord Developer Portal > sua aplicação > OAuth2
# Cadastre lá o Redirect: http://localhost:3000/api/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Chave que assina o cookie de sessão. MÍNIMO 32 caracteres.
# Gere com:  openssl rand -hex 32
# Trocar essa chave desloga todo mundo (o que é útil em emergência).
SESSION_SECRET=

# IDs do Discord com acesso ao painel /admin, separados por vírgula.
# VAZIO = NINGUÉM ENTRA. É proposital: variável esquecida não pode virar
# painel aberto. Pegue seu ID no Discord com o Modo Desenvolvedor ligado.
ADMIN_DISCORD_IDS=

# ---------- Links ----------
NEXT_PUBLIC_INVITE_URL=https://discord.com/oauth2/authorize?client_id=SEU_CLIENT_ID&scope=bot+applications.commands&permissions=274877959168
NEXT_PUBLIC_SUPPORT_URL=https://discord.gg/SEU_CONVITE
